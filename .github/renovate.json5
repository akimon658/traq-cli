{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "3 days",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":disableRateLimiting",
    "schedule:monthly",
    "security:gomodIndirectSecurityUpdates"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
